# Gunakan Red Hat UBI 8 (minimal)
FROM registry.access.redhat.com/ubi8/ubi

LABEL maintainer="fels@gmail.com" \
      version="1.0" \
      description="EastNets AppLauncher 5.1.6 (Java 11, UBI8)"

# Install OpenJDK 11 minimal
RUN dnf install -y java-11-openjdk \
    --setopt=install_weak_deps=False --nodocs && \
    dnf clean all && \
    rm -rf /var/cache/dnf /var/cache/yum

# Tambahkan user non-root
RUN groupadd -g 1085 safewatch && \
    useradd -u 1085 -g safewatch -s /sbin/nologin -d /app safewatch

# Buat struktur direktori dan set permission
RUN mkdir -p /applauncher /applauncher/logs /app/inout/input /app/inout/output /app/config && \
    chown -R safewatch:safewatch /app /applauncher

# Set direktori kerja
WORKDIR /applauncher

# Salin semua isi folder applauncher (termasuk .jar dan .xml)
COPY --chown=safewatch:safewatch applauncher/ /applauncher/ 
COPY --chown=safewatch:safewatch config/ /app/config/

# Ganti ke user non-root
USER safewatch

# Set environment variable jika diperlukan
ENV EASTNETS_CONFIG_HOME=/app/config \
    JAVA_OPTS=""

# Jalankan JAR
CMD ["java", "-jar", "side-applimanager.jar"]
