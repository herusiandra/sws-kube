<?xml version="1.0" encoding="UTF-8"?>

<configuration>

	<!-- Application description -->
	<application-definition>
		<id>SPP</id>
	</application-definition>
	
	<database>
		<domain-node-login>
			<name>SasDomainNodeOra.driver.xml</name>
			<file>
				<location>[CONFIGURATION_HOME]</location>
				<name>en-domain-nodeOra.user.sxml</name>
				<encrypted>yes</encrypted>
			</file>
		</domain-node-login>
		
		<domain-node-login>
			<name>SfpDomainNodeOra.driver.xml</name>
			<file>
				<location>[CONFIGURATION_HOME]</location>
				<name>en-domain-nodeOra.user.sxml</name>
				<encrypted>yes</encrypted>
			</file>
		</domain-node-login>

	</database>

	<!--  Logging -->
	<event-logging>

		<enabled>true</enabled>

		<handler>
			<class>
				com.sideinternational.sas.event.logging.handler.event.EventConsoleHandler
			</class>
			<name>SIDE_CONSOLE</name>
			<parameters>
				<enabled>TRUE</enabled>
				<level>DEBUG</level>
				<formatter-class>
					com.sideinternational.sas.event.logging.handler.event.EventFormatter
				</formatter-class>
				<filter-class>
					com.sideinternational.sas.event.logging.handler.event.EventFilter
				</filter-class>
			</parameters>
		</handler>

		<handler>
			<class>
				com.sideinternational.sas.event.logging.handler.event.EventFileHandler
			</class>
			<name>SIDE_FILE</name>
			<parameters>
				<enabled>TRUE</enabled>
				<level>DEBUG</level>
				<formatter-class>
					com.sideinternational.sas.event.logging.handler.event.EventFormatter
				</formatter-class>
				<filter-class>
					com.sideinternational.sas.event.logging.handler.event.EventFilter
				</filter-class>
				<file-parameters>
					<prefix>Event_</prefix>
					<suffix>.log</suffix>
					<directory>logfiles/</directory>
				</file-parameters>
			</parameters>
		</handler>

		<handler>
			<class>
				com.sideinternational.sas.event.logging.handler.exception.ExceptionFileHandler
			</class>
			<name>SIDE_EXC_FILE</name>
			<parameters>
				<enabled>TRUE</enabled>
				<level>INFO</level>
				<formatter-class>
					com.sideinternational.sas.event.logging.handler.exception.ExceptionFormatter
				</formatter-class>
				<filter-class>
					com.sideinternational.sas.event.logging.handler.exception.ExceptionFilter
				</filter-class>
				<file-parameters>
					<prefix>Exception_</prefix>
					<suffix>.log</suffix>
					<directory>logfiles/</directory>
				</file-parameters>
			</parameters>
		</handler>

		<handler>
			<class>
				com.sideinternational.sas.event.audit.handler.AuditDBHandler
			</class>
			<name>SIDE_DB</name>
			<parameters>
				<enabled>TRUE</enabled>
				<level>INFO</level>
				<formatter-class>
					com.sideinternational.sas.event.audit.handler.DummyFormatter
				</formatter-class>
				<filter-class>
					com.sideinternational.sas.event.audit.handler.AuditFilter
				</filter-class>
			</parameters>
		</handler>

	</event-logging>

	<event-definition>

		<attribute-finder-class>com.sideinternational.web.swaf.event.EventAttributeFinderImpl</attribute-finder-class>

		<resource>
			<event-type-bundles>
				<bundle-base-name>com.sideinternational.sas.event.resource.SASEventTypeResources</bundle-base-name>
				<bundle-base-name>com.sideinternational.web.swaf.event.SWAFEventTypeResources</bundle-base-name>
				<bundle-base-name>com.sideinternational.sfs.event.SFSEventTypeResources</bundle-base-name>
			</event-type-bundles>
			<event-text-bundles>
				<bundle-base-name>com.sideinternational.sas.event.resource.SASEventResources</bundle-base-name>
				<bundle-base-name>com.sideinternational.web.swaf.event.SWAFEventResources</bundle-base-name>
				<bundle-base-name>com.sideinternational.sfs.event.SFSEventResources</bundle-base-name>
			</event-text-bundles>
			<default-locale-name>en</default-locale-name>
			<client-locale-finder-class>com.sideinternational.web.swaf.ClientLocaleFinderImpl</client-locale-finder-class>
		</resource>

		<validator>
			<locales>
				<locale-name>en</locale-name>
				<locale-name>fr</locale-name>
			</locales>
			<packages>
				<package-name>
					com.sideinternational.web.swaf.event.security
				</package-name>
				<package-name>
					com.sideinternational.web.swaf.event.system
				</package-name>
				<package-name>
					com.sideinternational.sas.event.resource.configuration
				</package-name>
				<package-name>
					com.sideinternational.sas.event.resource.debug
				</package-name>
				<package-name>
					com.sideinternational.sas.event.resource.security
				</package-name>
				<package-name>
					com.sideinternational.sas.event.resource.system
				</package-name>
				<package-name>
					com.sideinternational.sfs.event.system
				</package-name>
			</packages>
		</validator>

	</event-definition>

	<!--  Options -->
	<application-options>
		<updatable-user-display-name>YES</updatable-user-display-name>
		<updatable-user-zone>NO</updatable-user-zone>
		<max-login-failed>3</max-login-failed>
		<!--<password-expire-after>30</password-expire-after>-->
		<resource-access-class>com.sideinternational.web.swaf.util.ResourceAccessImpl</resource-access-class>
		<debug-mode>false</debug-mode>
		<tracker-udp-port></tracker-udp-port>
		<temp-dir></temp-dir>
	</application-options>

	<!-- User authentication parameters -->
	<user-authentication>

		<ldap-parameters>
			<ldap-server name="LDAP1">
			   <server-location>ldap://192.168.253.230:389</server-location>                                    <!-- The LDAP location (e.g: ldap://yourLdapHost:portNumber). -->
			   <securityPrincipal>cn=eastnets,ou=Users,dc=eastnets,dc=com</securityPrincipal>
			   <securityCredential>eastnets</securityCredential>
			   <securityAuthentication>simple</securityAuthentication>
			   <securityProtocol>plain</securityProtocol>                                                      <!-- Protocol  (plain,ssl) -->		   
			   <baseContext>dc=eastnets,dc=com</baseContext>
			   <targetUser>ou=Users</targetUser>      
			   <loginAttribute>sAMAccountName</loginAttribute>
			   <firstNameAttribute>givenName</firstNameAttribute>
			   <lastNameAttribute>displayName</lastNameAttribute>
			   <mailAttribute>mail</mailAttribute>
			   <searchScope>SUBTREE_SCOPE</searchScope>                                                          <!--TYPE OF SEARCH (OBJECT_SCOPE,ONELEVEL_SCOPE,SUBTREE_SCOPE) -->
		    </ldap-server>
		</ldap-parameters>
		
	</user-authentication>

	<!-- Concrete implementations used by the SAS library -->
	<services-implementation>
		<user-class></user-class>
		<usergroup-class></usergroup-class>
		<profile-class>com.sideinternational.web.swaf.SWAFProfile</profile-class>
		<authentication-class></authentication-class>
   		<authorization-class>com.sideinternational.sas.service.impl.scdb.AuthorizationServiceImpl</authorization-class>		
		<application-class></application-class>
		<module-class>com.sideinternational.web.swaf.SWAFModule</module-class>
		<zone-class></zone-class>
		<report-datasource-class>com.sideinternational.web.filtering.ReportDataSource</report-datasource-class>
  		<reporting-class>com.sideinternational.sas.service.impl.JasperReportBeanService</reporting-class>
		<current-operator-finder-class>com.sideinternational.web.webplatform.CurrentOperatorFinderImpl</current-operator-finder-class>
		<current-application-finder-class>com.sideinternational.web.webplatform.CurrentApplicationFinderImpl</current-application-finder-class>
	</services-implementation>

</configuration>

